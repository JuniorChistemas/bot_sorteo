{
  "name": "bot-sorteo",
  "version": "1.0.0",
  "main": "dist/index.js",
  "license": "MIT",
  "description": "Bot de whatsapp para realizar sorteos asignando un numero aleatorio a cada participante luego es escribir la palabra clave",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:logs": "docker-compose logs -f bot_sorteo"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "1.34.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}